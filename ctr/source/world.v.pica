; The world's vertices as the level stores them (HlCtrDecode.hpp's Vertex):
; position in quarter units (the modelView's scale takes them to units),
; texture coordinate in 12.4 texels (texScale takes them to 0..1, and turns
; them up the other way, as the PICA has its pictures), colour in bytes
; (1/248: the DS's full 31, widened, is white).

.fvec projection[4], modelView[4]
.fvec texScale

.constf consts(1.0, 0.0, 0.0040322581, 0.0)
.alias ONE consts.xxxx

.out outPos position
.out outTex texcoord0
.out outClr color

.alias inPos v0
.alias inTex v1
.alias inClr v2

.proc main
    mov r0.xyz, inPos
    mov r0.w, ONE

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outPos.x, projection[0], r1
    dp4 outPos.y, projection[1], r1
    dp4 outPos.z, projection[2], r1
    dp4 outPos.w, projection[3], r1

    mul outTex, texScale, inTex

    mul outClr, consts.zzzz, inClr
    end
.end
